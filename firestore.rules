rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasValidProfileShape() {
        return request.resource.data.keys().hasAll(['displayName', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt >= request.resource.data.createdAt;
      }

      allow get: if isOwner();
      allow create, update: if isOwner() && hasValidProfileShape();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
